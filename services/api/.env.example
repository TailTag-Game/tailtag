# Copy this file to .env for local development. It contains safe local-only
# defaults, never production values. .env is ignored by Git and must not be committed.
# Production settings do not load this file.

# Required by local Django and the Compose API. Native Django uses this URL and
# reaches the Compose-published PostgreSQL port at 127.0.0.1:5432.
DJANGO_SECRET_KEY=tailtag-local-development-secret
DATABASE_URL=postgresql://tailtag:tailtag-local-password@127.0.0.1:5432/tailtag

# Optional local Django settings. These safe defaults are also used when omitted.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Required by Compose to bootstrap PostgreSQL 17. Compose uses these values to
# give Django a container-network URL with the db hostname; Django itself reads
# only DATABASE_URL.
POSTGRES_DB=tailtag
POSTGRES_USER=tailtag
POSTGRES_PASSWORD=tailtag-local-password

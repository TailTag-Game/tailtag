# Values in this file are local-development placeholders. Do not use them in production.
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DATABASE_URL=postgresql://tailtag:replace-with-a-local-password@localhost:5432/tailtag
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL bootstrap values used by Compose.
POSTGRES_DB=tailtag
POSTGRES_USER=tailtag
POSTGRES_PASSWORD=replace-with-a-local-password

# Copy this file to .env for local development. It contains safe local-only
# defaults, never production values. .env is ignored by Git and must not be committed.
# Production settings do not load this file.

# Required by local Django and the Compose API. Native Django uses this URL and
# reaches the Compose-published PostgreSQL port at 127.0.0.1:5432.
DATABASE_URL=postgresql://tailtag:tailtag-local-password@127.0.0.1:5432/tailtag
DJANGO_SECRET_KEY=tailtag-local-development-secret

# Optional local Django settings. These safe defaults are also used when omitted.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Clerk request authentication is disabled by default. When enabled, both
# CLERK_JWT_KEY and comma-separated CLERK_AUTHORIZED_PARTIES are required.
CLERK_AUTHENTICATION_ENABLED=false

# Authenticated smoke tooling is Development-only and does not load this file
# automatically. Export or prefix only these non-secret values when invoking it.
# Create and retain one dedicated Clerk Development user manually, then copy its
# opaque ID here for convenience if desired; never use mutable profile fields.
# CLERK_SMOKE_USER_ID=user_development_smoke
# For Railway development, use its exact HTTPS API root (no trailing path).
# TAILTAG_DEVELOPMENT_API_BASE_URL=https://<exact-development-api-host>
# Both local and Railway development APIs must include this fixed synthetic
# tooling origin in CLERK_AUTHORIZED_PARTIES. No frontend runs on port 3000.
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Never add the synthetic origin to production configuration. The command asks
# for its Development secret invisibly for each invocation; do not store it.

# Required by Compose to bootstrap PostgreSQL 17. Compose uses these values to
# give Django a container-network URL with the db hostname; Django itself reads
# only DATABASE_URL.
POSTGRES_DB=tailtag
POSTGRES_PASSWORD=tailtag-local-password
POSTGRES_USER=tailtag

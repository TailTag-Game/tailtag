{
  "name": "TailTag API",
  "dockerComposeFile": [
    "../services/api/compose.yaml",
    "compose.devcontainer.yaml"
  ],
  "service": "api",
  "workspaceFolder": "/workspaces/tailtag",
  "remoteUser": "tailtag",
  "updateRemoteUserUID": true,
  "remoteEnv": {
    "TAILTAG_DEVCONTAINER": "1"
  },
  "postCreateCommand": "uv --directory services/api sync --all-groups --locked && uv --directory .semgrep sync --locked",
  "forwardPorts": [8000]
}
